# The address people open, without https://. It must match the public hostname
# configured on the Cloudflare Tunnel.
DOMAIN=draw.example.com

# Anyone with this token can run the tunnel; see deploy/README.md for where to find it
TUNNEL_TOKEN=

# From Google Cloud; see server/README.md for the setup steps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=example.com
# optional: accounts let in regardless of domain; normally empty
ALLOWED_EMAILS=

# openssl rand -base64 48
SESSION_SECRET=

# optional: enables "Open from Drive" and "Choose save folder"
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# share links and collab rooms nobody opened for this long are deleted
RETENTION_DAYS=180
